{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://mfzxqjjqrxrjovvlinhd.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "comfortcommute",
      "version": "0.1.0",
      "title": "ComfortCommute"
    },
    "tools": [
      {
        "name": "search_places",
        "title": "Search Singapore places",
        "description": "Search Singapore addresses, landmarks, MRT/LRT stations and bus stops. Returns coordinates to feed into plan_commute.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "description": "Place, address, station or bus stop name to look for."
            },
            "limit": {
              "default": 8,
              "description": "Maximum number of results.",
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "plan_commute",
        "title": "Plan a commute",
        "description": "Plan and rank Singapore public-transport journeys between two coordinates, priced for the commuter's fare card. Use search_places first to get coordinates.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "originName": {
              "type": "string",
              "minLength": 1,
              "description": "Human-readable origin name."
            },
            "originLat": {
              "type": "number",
              "description": "Origin latitude."
            },
            "originLng": {
              "type": "number",
              "description": "Origin longitude."
            },
            "destinationName": {
              "type": "string",
              "minLength": 1,
              "description": "Human-readable destination name."
            },
            "destinationLat": {
              "type": "number",
              "description": "Destination latitude."
            },
            "destinationLng": {
              "type": "number",
              "description": "Destination longitude."
            },
            "priority": {
              "default": "balanced",
              "description": "What to optimise the ranking for.",
              "type": "string",
              "enum": [
                "comfort",
                "time",
                "balanced",
                "price"
              ]
            }
          },
          "required": [
            "originName",
            "originLat",
            "originLng",
            "destinationName",
            "destinationLat",
            "destinationLng"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_favourites",
        "title": "List saved favourites",
        "description": "List the signed-in commuter's saved journeys, saved bus/train stops and saved places in ComfortCommute.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "kind": {
              "default": "all",
              "description": "Which kind of favourite to return.",
              "type": "string",
              "enum": [
                "all",
                "routes",
                "stops",
                "places"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "save_favourite_route",
        "title": "Save a favourite journey",
        "description": "Save a journey to the signed-in commuter's ComfortCommute favourites so it is watched for disruptions.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Label for the saved journey, e.g. 'Morning commute'."
            },
            "originName": {
              "type": "string",
              "minLength": 1,
              "description": "Origin name."
            },
            "originLat": {
              "description": "Origin latitude.",
              "type": "number"
            },
            "originLng": {
              "description": "Origin longitude.",
              "type": "number"
            },
            "destinationName": {
              "type": "string",
              "minLength": 1,
              "description": "Destination name."
            },
            "destinationLat": {
              "description": "Destination latitude.",
              "type": "number"
            },
            "destinationLng": {
              "description": "Destination longitude.",
              "type": "number"
            },
            "priority": {
              "default": "balanced",
              "type": "string",
              "enum": [
                "comfort",
                "time",
                "balanced",
                "price"
              ]
            }
          },
          "required": [
            "name",
            "originName",
            "destinationName"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_alerts",
        "title": "List commute alerts",
        "description": "List disruption and crowd alerts raised for the signed-in commuter's saved routes and stops, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "unreadOnly": {
              "default": false,
              "description": "Return only alerts the commuter has not read yet.",
              "type": "boolean"
            },
            "limit": {
              "default": 20,
              "description": "Maximum number of alerts to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
